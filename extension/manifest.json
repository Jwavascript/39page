{
  "manifest_version": 3,
  "name": "39page",
  "version": "1.0.0",
  "description": "YouTube 에서 보고 있는 영상과 지금 이 순간을 39page 로 담습니다. 저장은 39page 화면에서 직접 확인하고 합니다.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "39page — YouTube 에서 담기",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting"],
  "commands": {
    "quick-add": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "지금 YouTube 영상을 39page 플레이리스트에 담기 (수집 화면 열기)"
    },
    "capture-moment": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "지금 재생 시점을 39page Moment 로 고정 (수집 화면 열기)"
    }
  }
}

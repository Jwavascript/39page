{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["../../env.d.ts", "web/**/*.ts", "tests/**/*.ts", "extension/protocol.js"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["vitest/globals"],
    "paths": { "@/*": ["../../src/*"] },
    "noEmit": true
  }
}

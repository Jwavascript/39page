{
  "manifest_version": 3,
  "name": "39page bridge PoC (DEV ONLY — M11-1)",
  "version": "0.0.1",
  "description": "M11-1 기술 검증용 실험 확장. 배포하지 않는다. 로컬 127.0.0.1:4173 의 39page 빌드에만 연결한다.",
  "key": "",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "39page bridge PoC"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "offscreen"],
  "host_permissions": ["http://127.0.0.1:4173/*"],
  "externally_connectable": {
    "matches": ["http://127.0.0.1:4173/*"]
  },
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "panel.js", "panel.css", "protocol.js"],
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"]
    }
  ]
}
